node_modules/
dist/
*.tsbuildinfo

.next/
next-env.d.ts

# Secrets — never commit. See .env.example for the required names. If one lands
# in a commit anyway, rotate it at the provider first; the tree is public and a
# force-push does not unpublish anything.
.env
.env.*
!.env.example
.envrc

# Key material. Nothing in this project needs a key file on disk; if one shows
# up it arrived by accident.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
service-account*.json

.vercel/
# Supabase CLI scratch (linked-project cache, version check). Not config —
# supabase/config.toml, if we ever add one, is meant to be committed.
supabase/.temp/
coverage/
.DS_Store

# Local scratch output from scripts/ (fetched pages, reparse dumps)
tmp/

# Personal Claude Code state — the whole directory, local only.
.claude/

# Record keeping is local-only. This repo is public, so markdown is ignored by
# DEFAULT and published documents are opted in below, one at a time. Planning,
# working notes, agent instructions, and internal security detail never leave
# the workstation.
#
# Adding a doc meant for readers? Add an exception here in the same commit —
# `git add -f` would sneak it past this rule and past review.
*.md
!README.md
!docs/**/*.md
!LICENSE.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md

notes/
scratch/
