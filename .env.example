# Copy to .env.local for local runs. NEVER commit a filled-in copy.
# On Vercel these are Environment Variables on the apps/web project, Production
# scope. DIRECT_DATABASE_URL is the exception — it is workstation-only.

# Supabase Postgres. Use the TRANSACTION pooler (port 6543) for serverless runs.
# Prepared statements must be disabled on the pooler; the client does this already.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct/session connection (port 5432) — used ONLY by drizzle-kit migrations.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage, for immutable raw HTML snapshots.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=snapshots

# Shared secret for the cron route. YOU set the value — Vercel does not generate
# one. What Vercel does is send `Authorization: Bearer $CRON_SECRET` on every
# scheduled invocation, using whatever this variable holds, so an unset value
# means unsigned cron requests and the route refuses them (503, fails closed).
# Vercel's cron is the only trigger; there is no backstop.
CRON_SECRET=

# Contact address embedded in the outbound User-Agent (polite crawling).
# REQUIRED — the fetcher throws MissingContactEmailError rather than crawl NYCHA
# anonymously. There is no default. Reserved domains (example.com, .invalid,
# .test, localhost) are rejected, so this cannot be satisfied with a stand-in.
# Deliberately not committed: the repo is public. See packages/config/src/index.ts.
ARCHIVE_CONTACT_EMAIL=
